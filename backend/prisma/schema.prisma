// backend/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  employeeId    String    @unique @map("employee_id")
  email         String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  isActive      Boolean   @default(true) @map("is_active")
  
  roleId        String    @map("role_id") @db.Uuid
  departmentId  String?   @map("department_id") @db.Uuid
  snapshotUrl  String?  @map("snapshot_url") @db.Text

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  role            Role              @relation(fields: [roleId], references: [id])
  department      Department?       @relation(fields: [departmentId], references: [id])
  faceDescriptors FaceDescriptor[]
  attendanceLogs  AttendanceLog[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  permissions Json     @default("{}")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]

  @@map("roles")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       User[]

  @@map("departments")
}

model FaceDescriptor {
  id          String   @id @default(uuid()) @db.Uuid 
  userId      String   @map("user_id") @db.Uuid
  descriptor  String   @db.Text
  snapshotUrl String?  @map("snapshot_url")
  isPrimary   Boolean  @default(true) @map("is_primary")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("face_descriptors")
}

model AttendanceLog {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  type             LogType
  timestamp        DateTime          @default(now())
  status           Status            @default(SUCCESS)
  attendanceStatus AttendanceStatus  @default(ON_TIME)
  lateMinutes      Int?              @map("late_minutes")
  confidence       Float?
  snapshotUrl      String?           @map("snapshot_url")
  
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@map("attendance_logs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json     
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

enum LogType {
  IN
  OUT
}

enum Status {
  SUCCESS
  FAILED
  SPOOF_DETECTED
}

enum AttendanceStatus {
  ON_TIME
  LATE
}